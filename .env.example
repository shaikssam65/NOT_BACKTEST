# Copy to .env and fill in. PAPER_MODE defaults to true.

PAPER_MODE=true
DATABASE_PATH=data/db/trading.db

# Zerodha Kite Connect — live holdings, quotes, orders
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Must match the Redirect URL on the Kite Connect app form exactly.
KITE_REDIRECT_URL=http://127.0.0.1:8501/

# Finnhub — company + market news (free key at https://finnhub.io/)
FINNHUB_API_KEY=

# Optional / unused by the simple bot UI (kept for older modules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
