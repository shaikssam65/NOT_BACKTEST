# Copy to .env and fill in. PAPER_MODE defaults to true and must be
# set to false explicitly before any live-order work (Phase 4+).

PAPER_MODE=true
DATABASE_PATH=data/db/trading.db

# Optional — without this key the AI layer uses a deterministic heuristic
# fallback and still logs every decision.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional — used for historical bars when present; otherwise yfinance.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Must match the Redirect URL on the Kite Connect app form exactly.
KITE_REDIRECT_URL=http://127.0.0.1:8501/
